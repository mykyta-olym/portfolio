---
import { Image } from 'astro:assets';
import { fieldTiles } from '@/data/disciplines';

// Tiles sit on a 4 by 4 pattern of cells, each nudged off-centre so the field looks loose.
const columns = 4;
const nudges = [
  [0.1, 0.05],
  [-0.08, 0.18],
  [0.12, -0.06],
  [-0.1, 0.1],
  [0.06, -0.12],
  [-0.12, 0.04],
  [0.08, 0.16],
  [-0.04, -0.1],
];
const tiles = fieldTiles.map((image, index) => {
  const nudge = nudges[index % nudges.length] ?? [0, 0];
  return {
    image,
    x: index % columns,
    y: Math.floor(index / columns),
    dx: nudge[0],
    dy: nudge[1],
    wide: image.src.width / image.src.height > 1.3,
  };
});
---

<section class="field" data-module="drag-field" data-cursor="Drag" aria-labelledby="about-title">
  <ul class="field__tiles" aria-hidden="true">
    {tiles.map((tile) => (
      <li
        class:list={['field__tile', { 'field__tile--wide': tile.wide }]}
        data-field-tile
        data-x={tile.x}
        data-y={tile.y}
        style={`--x: ${tile.x}; --y: ${tile.y}; --dx: ${tile.dx}; --dy: ${tile.dy}`}
      >
        <Image src={tile.image.src} alt="" widths={[320, 560]} sizes="(min-width: 768px) 18vw, 40vw" loading="eager" draggable="false" />
      </li>
    ))}
  </ul>
  <div class="field__title" data-field-title>
    <h1 id="about-title" data-reveal="lines">
      Across the stack
    </h1>
    <p class="field__meta" data-reveal="fade" data-reveal-delay="0.4">
      Kyiv / Košice
    </p>
  </div>
  <p class="field__hint" data-reveal="fade" data-reveal-delay="0.8">
    Drag to explore
  </p>
</section>

<style>
  /* Tiles are placed around the centre on a grid of cells. The script uses the same
     formula, so taking over from these first-paint positions moves nothing. */
  .field {
    --cell: max(220px, 100cqw / 4.2);
    --cell-h: calc(var(--cell) * 0.82);
    container-type: inline-size;
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    background: var(--color-black);
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
    perspective: 1400px;
  }

  .field:global(.is-dragging) {
    cursor: grabbing;
  }

  .field__tiles {
    position: absolute;
    inset: 0;
  }

  .field__tile {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(calc((var(--x) - 2) * var(--cell)), calc((var(--y) - 2) * var(--cell-h)), 0);
    width: clamp(7rem, 12vw, 13rem);
    aspect-ratio: 4 / 5;
    margin-left: calc(var(--dx) * 10vw);
    margin-top: calc(var(--dy) * 10vw);
    overflow: hidden;
    border-radius: 3px;
    background: #0b0b0c;
    will-change: transform;
    transition: filter 0.4s ease;
  }

  .field__tile--wide {
    width: clamp(9rem, 15vw, 16rem);
    aspect-ratio: 16 / 10;
  }

  .field__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    filter: grayscale(0.85) brightness(0.8);
    transition: filter 0.5s ease;
  }

  .field:hover .field__tile :global(img) {
    filter: grayscale(0.4) brightness(0.92);
  }

  .field__title {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    pointer-events: none;
    filter: blur(var(--field-blur, 0px));
    text-shadow: 0 0 40px rgb(0 0 0 / 80%);
  }

  .field__title h1 {
    font-size: var(--fs-gallery);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .field__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .field__hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    font-family: var(--font-label);
    font-size: var(--fs-tag);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  @media (max-width: 767px) {
    .field {
      --cell: max(220px, 100cqw / 2.1);
    }
  }

  @media (pointer: fine) {
    .field__hint {
      display: none;
    }
  }
</style>
