---
import { Image } from 'astro:assets';
import { fieldTiles } from '@/data/disciplines';

// Four columns, with bounded offsets to keep the photographs apart.
const columns = 4;
const rows = Math.ceil(fieldTiles.length / columns);
const nudges = [
  [0.1, 0.05],
  [-0.08, 0.18],
  [0.12, -0.06],
  [-0.1, 0.1],
  [0.06, -0.12],
  [-0.12, 0.04],
  [0.08, 0.16],
  [-0.04, -0.1],
];
const tiles = fieldTiles.map((image, index) => {
  const nudge = nudges[index % nudges.length] ?? [0, 0];
  return {
    image,
    x: index % columns,
    y: (Math.floor(index / columns) + 1) % rows,
    dx: nudge[0],
    dy: nudge[1],
    ratio: image.kind === 'render' ? 0.8 : image.src.width / image.src.height,
  };
});
---

<section class="field" style={`--rows: ${rows}`} data-module="drag-field" data-cursor="Drag Me" aria-labelledby="about-title">
  <ul class="field__tiles" aria-hidden="true">
    {tiles.map((tile) => (
      <li
        class="field__tile"
        data-field-tile
        data-x={tile.x}
        data-y={tile.y}
        style={`--x: ${tile.x}; --y: ${tile.y}; --dx: ${tile.dx}; --dy: ${tile.dy}; --ratio: ${tile.ratio}`}
      >
        <Image src={tile.image.src} alt="" widths={[320, 560]} sizes="(min-width: 768px) 18vw, 40vw" loading="eager" draggable="false" />
      </li>
    ))}
  </ul>
  <div class="field__title">
    <div class="field__heading" data-field-title>
      <h1 id="about-title" data-reveal="lines">
        Across the stack
      </h1>
      <p class="field__meta" data-reveal="fade" data-reveal-delay="0.2">
        Kyiv / Košice
      </p>
    </div>
  </div>
  <p class="field__hint" data-reveal="fade" data-reveal-delay="0.35">
    Drag to explore
  </p>
</section>

<style>
  /* Static fallback grid. Enhanced mode reveals its canvas after the textures are ready. */
  .field {
    --cell: max(220px, 100cqw / 3.6);
    --cell-h: 56cqh;
    container-type: size;
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    background: var(--color-black);
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }

  .field:global(.is-dragging) {
    cursor: grabbing;
  }

  .field__tiles {
    position: absolute;
    inset: 0;
  }

  .field:global(.has-webgl) .field__tiles {
    visibility: hidden;
  }

  :global(.js) .field:not(:global(.is-static)) .field__tiles {
    visibility: hidden;
  }

  .field :global(canvas[data-field-canvas]) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: grayscale(1);
    pointer-events: none;
  }

  .field__tile {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    transform: translate3d(calc((var(--x) - 1.5) * var(--cell)), calc((var(--y) - (var(--rows) - 1) / 2) * var(--cell-h)), 0);
    width: clamp(7rem, 16vw, 26rem);
    aspect-ratio: var(--ratio);
    margin-left: calc(var(--dx) * 10vw);
    margin-top: calc(var(--dy) * 10vw);
    overflow: hidden;
    background: #0b0b0c;
    will-change: transform;
    transition: filter 0.4s ease;
  }

  .field__tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    filter: grayscale(1);
  }

  .field__title {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    place-content: center;
    pointer-events: none;
  }

  .field__heading {
    display: grid;
    justify-items: center;
    text-shadow:
      0 1px 3px #000,
      0 2px 18px rgb(0 0 0 / 65%);
  }

  .field__title h1 {
    font-size: 45px;
    font-weight: 400;
    line-height: 80px;
    letter-spacing: -0.5px;
    color: #ececec;
  }

  .field__meta {
    font-family: var(--font-label);
    font-size: 13px;
    line-height: 18.2px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .field__hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    font-family: var(--font-label);
    font-size: var(--fs-tag);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  @media (max-width: 1024px) {
    .field__title h1 {
      font-size: 35px;
    }
    .field__meta {
      font-size: 10px;
      letter-spacing: 2.5px;
    }
  }

  @media (max-width: 767px) {
    .field {
      --cell: max(220px, 100cqw / 2.1);
    }
    .field__title h1 {
      font-size: 24px;
      line-height: 26px;
    }
    .field__meta {
      font-size: 12px;
    }
  }

  @media (pointer: fine) {
    .field__hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .field .field__tiles {
      visibility: visible;
    }
  }
</style>
