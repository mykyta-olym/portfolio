---
import { Image } from 'astro:assets';
import servers from '@/assets/backgrounds/servers.webp';
import network from '@/assets/backgrounds/network.webp';
import code from '@/assets/backgrounds/code.webp';
import inventory from '@/assets/backgrounds/inventory.webp';
import garden from '@/assets/backgrounds/garden.webp';
import microphone from '@/assets/backgrounds/microphone.webp';

interface Props {
  slug: string;
}
const backgrounds = {
  relayq: { src: servers, position: '70% 50%' },
  phishlens: { src: network, position: '50% 30%' },
  gitpulse: { src: code, position: '58% 50%' },
  stockroom: { src: inventory, position: '40% 50%' },
  'garden-of-lost-paths': { src: garden, position: '50% 60%' },
  'speech-domain-adaptation': { src: microphone, position: '60% 50%' },
};
const background = backgrounds[Astro.props.slug as keyof typeof backgrounds];
---

{background && (
  <div class="case-backdrop" aria-hidden="true">
    <Image
      src={background.src}
      alt=""
      widths={[640, 1280, 1920, 2400]}
      sizes="(max-aspect-ratio: 3/2) 180vh, 110vw"
      loading="eager"
      fetchpriority="high"
      class="case-backdrop__image"
      style={`object-position: ${background.position}`}
      data-case-background
    />
  </div>
)}

<style>
  .case-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: #000;
  }
  .case-backdrop :global(img) {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.58);
  }
  .case-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0006, #0005 35%, #0008 70%, #000 100%);
  }
</style>
