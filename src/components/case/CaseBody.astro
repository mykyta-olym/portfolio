---
import { Image } from 'astro:assets';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Project } from '@/types/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="case" aria-label={`${project.name} case study`}>
  <aside class="case__panel">
    <div class="case__sticky">
      <div class="case__top">
        <SectionLabel text="Case study" />
        <a class="case__code" href={project.repository} target="_blank" rel="noopener">
          View code <Icon name="arrow-up-right" size={12} />
        </a>
      </div>
      <h2 class="case__name">{project.name}</h2>
      <p class="case__summary">{project.summary}</p>

      <dl class="case__facts">
        <div>
          <dt>Stack</dt>
          <dd>{project.stack.join(', ')}</dd>
        </div>
        <div>
          <dt>Type</dt>
          <dd>{project.kind}</dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>{project.year}</dd>
        </div>
      </dl>

      <ul class="case__metrics">
        {project.metrics.map((metric) => (
          <li>
            <span class="case__metric-value">{metric.value}</span>
            <span class="case__metric-label">{metric.label}</span>
          </li>
        ))}
      </ul>

      <div class="case__tabs" data-module="tabs">
        <div class="case__tablist" role="tablist" aria-label="Case study sections">
          {project.sections.map((section, index) => (
            <button
              class="case__tab"
              type="button"
              role="tab"
              id={`tab-${section.id}`}
              aria-controls={`panel-${section.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {section.title}
            </button>
          ))}
        </div>
        {project.sections.map((section) => (
          <div class="case__tabpanel" role="tabpanel" id={`panel-${section.id}`} aria-labelledby={`tab-${section.id}`} tabindex="0">
            <h3 class="case__section-title">{section.title}</h3>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ))}
      </div>
      {project.credits && <p class="case__credits">{project.credits}</p>}
    </div>
  </aside>

  <div class="case__gallery">
    {project.gallery.map((item, index) => (
      <figure class="case__figure" data-reveal="fade">
        <Image
          src={item.src}
          alt={item.alt}
          widths={[640, 1080, 1600]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      </figure>
    ))}
  </div>
</section>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 33vw) minmax(0, 1fr);
    gap: 4vw;
    padding: clamp(4rem, 7vw, 7rem) var(--gutter) clamp(4rem, 7vw, 7rem) var(--gutter);
    background: var(--color-black);
  }

  .case__sticky {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .case__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .case__code {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--fs-small);
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgb(255 255 255 / 40%);
  }

  .case__code:hover {
    text-decoration-color: var(--color-white);
  }

  .case__name {
    font-family: var(--font-tight);
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .case__summary {
    font-size: var(--fs-body);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .case__facts {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .case__facts dt {
    font-family: var(--font-label);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .case__facts dd {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--color-white);
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-line);
  }

  .case__metrics li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  .case__metric-value {
    font-family: var(--font-tight);
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .case__metric-label {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-text-dim);
  }

  .case__tablist {
    display: none;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .case__tabs:global(.is-enhanced) .case__tablist {
    display: flex;
    flex-wrap: wrap;
  }

  .case__tab {
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-small);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .case__tab:hover {
    color: var(--color-white);
  }

  .case__tab[aria-selected='true'] {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-black);
  }

  .case__tabpanel {
    display: grid;
    gap: 0.85rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .case__tabpanel + .case__tabpanel {
    margin-top: 1.5rem;
  }

  .case__tabs:global(.is-enhanced) .case__tabpanel + .case__tabpanel {
    margin-top: 0;
  }

  .case__tabs:global(.is-enhanced) .case__section-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .case__section-title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-white);
  }

  .case__credits {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-dim);
  }

  .case__gallery {
    display: grid;
    gap: clamp(1rem, 2vw, 2rem);
    align-content: start;
  }

  .case__figure {
    overflow: hidden;
    border-radius: 3px;
    background: #0b0b0c;
  }

  .case__figure :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(1);
  }

  @media (max-width: 1023px) {
    .case {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .case__sticky {
      position: static;
    }
  }
</style>
