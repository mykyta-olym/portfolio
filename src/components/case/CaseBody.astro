---
import { Image } from 'astro:assets';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Icon from '@/components/ui/Icon.astro';
import type { Project } from '@/types/content';
import { href } from '@/lib/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="case" aria-label={`${project.name} case study`}>
  <aside class="case__panel">
    <div class="case__sticky">
      <div class="case__top">
        <SectionLabel text="Case study" />
        <a class="case__code" href={project.repository} target="_blank" rel="noopener">
          View code <Icon name="arrow-up-right" size={12} />
        </a>
      </div>
      <h2 class="case__name" data-reveal="fade">
        {project.name}
      </h2>
      <p class="case__summary" data-reveal="fade">
        {project.summary}
      </p>

      <dl class="case__facts" data-reveal="fade">
        <div>
          <dt>Stack</dt>
          <dd>{project.stack.join(', ')}</dd>
        </div>
        <div>
          <dt>Type</dt>
          <dd>{project.kind}</dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>{project.year}</dd>
        </div>
      </dl>

      <ul class="case__metrics" data-reveal="fade">
        {project.metrics.map((metric) => (
          <li>
            <span class="case__metric-value">{metric.value}</span>
            <span class="case__metric-label">{metric.label}</span>
          </li>
        ))}
      </ul>

      <div class="case__tabs" data-module="tabs" data-reveal="fade">
        <div class="case__tablist" role="tablist" aria-label="Case study sections">
          {project.sections.map((section, index) => (
            <button
              class="case__tab"
              type="button"
              role="tab"
              id={`tab-${section.id}`}
              aria-controls={`panel-${section.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              {section.title}
            </button>
          ))}
        </div>
        {project.sections.map((section) => (
          <div class="case__tabpanel" role="tabpanel" id={`panel-${section.id}`} aria-labelledby={`tab-${section.id}`} tabindex="0">
            <h3 class="case__section-title">{section.title}</h3>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ))}
      </div>
      {project.credits && <p class="case__credits">{project.credits}</p>}
    </div>
  </aside>

  <div class="case__gallery" data-module="media-gallery">
    {project.video && (
      <figure class="case__film" data-reveal="fade">
        <video controls playsinline preload="none" poster={href(project.video.poster)} aria-label={project.video.label}>
          <source src={href(project.video.src)} type="video/mp4" />
        </video>
        <figcaption>{project.video.label}</figcaption>
      </figure>
    )}
    {project.gallery.map((item, index) => (
      <figure class="case__figure" data-reveal="fade">
        <a
          href={item.src.src}
          data-gallery-image
          data-caption={item.caption ?? item.alt}
          aria-label={`Enlarge image ${index + 1}: ${project.name}`}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[640, 1080, 1600]}
            sizes="(min-width: 1024px) 58vw, 100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <span class="case__enlarge" aria-hidden="true">
            <Icon name="arrow-up-right" size={18} />
          </span>
        </a>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))}
    <dialog class="viewer" aria-labelledby="viewer-title" data-gallery-dialog>
      <div class="viewer__bar">
        <h2 id="viewer-title">{project.name}</h2>
        <span data-gallery-count aria-live="polite"></span>
        <a data-gallery-original href={project.gallery[0]?.src.src} target="_blank" rel="noopener">
          Open original
        </a>
        <button type="button" data-gallery-close aria-label="Close image viewer">
          Close <Icon name="close" size={14} />
        </button>
      </div>
      <div class="viewer__image">
        <img data-gallery-full alt="" />
      </div>
      <div class="viewer__foot">
        <button type="button" data-gallery-prev aria-label="Previous image">
          <span class="viewer__previous-icon">
            <Icon name="chevron-right" size={18} />
          </span>
        </button>
        <p data-gallery-caption></p>
        <button type="button" data-gallery-next aria-label="Next image">
          <Icon name="chevron-right" size={18} />
        </button>
      </div>
    </dialog>
  </div>
</section>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 33vw) minmax(0, 1fr);
    gap: 4vw;
    padding: clamp(4rem, 7vw, 7rem) var(--gutter) clamp(4rem, 7vw, 7rem) var(--gutter);
    background: var(--color-black);
  }

  .case__sticky {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .case__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .case__code {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--fs-small);
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgb(255 255 255 / 40%);
  }

  .case__code:hover {
    text-decoration-color: var(--color-white);
  }

  .case__name {
    font-family: var(--font-tight);
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .case__summary {
    font-size: var(--fs-body);
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .case__facts {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .case__facts dt {
    font-family: var(--font-label);
    font-size: var(--fs-tag);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .case__facts dd {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--color-white);
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-line);
  }

  .case__metrics li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  .case__metric-value {
    font-family: var(--font-tight);
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .case__metric-label {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-text-dim);
  }

  .case__tablist {
    display: none;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .case__tabs:global(.is-enhanced) {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .case__tabs:global(.is-enhanced) .case__tablist {
    grid-area: 1 / 1;
    display: flex;
    flex-wrap: wrap;
  }

  /* All panels size one grid cell; only the selected panel is visible or accessible. */
  .case__tabs:global(.is-enhanced) .case__tabpanel {
    grid-area: 2 / 1;
    align-content: start;
  }

  .case__tabs:global(.is-enhanced) .case__tabpanel[hidden] {
    display: grid !important;
    visibility: hidden;
    pointer-events: none;
  }

  .case__tab {
    height: 1.875rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-small);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .case__tab:hover {
    color: var(--color-white);
  }

  .case__tab[aria-selected='true'] {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-black);
  }

  .case__tabpanel {
    display: grid;
    gap: 0.85rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .case__tabpanel + .case__tabpanel {
    margin-top: 1.5rem;
  }

  .case__tabs:global(.is-enhanced) .case__tabpanel + .case__tabpanel {
    margin-top: 0;
  }

  .case__tabs:global(.is-enhanced) .case__section-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .case__section-title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-white);
  }

  .case__credits {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-dim);
  }

  .case__gallery {
    display: grid;
    gap: clamp(1rem, 2vw, 2rem);
    align-content: start;
  }

  .case__figure {
    min-width: 0;
  }

  .case__figure > a {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 3px;
    background: #161718;
    cursor: zoom-in;
  }

  .case__figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.32s var(--ease-hover);
  }

  .case__enlarge {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: #111;
    transform: translateY(8px);
    opacity: 0;
    transition:
      opacity var(--duration-hover) var(--ease-hover),
      transform var(--duration-hover) var(--ease-hover);
  }

  .case__figure > a:is(:hover, :focus-visible) .case__enlarge {
    opacity: 1;
    transform: none;
  }

  .case__figure figcaption,
  .case__film figcaption {
    max-width: 58rem;
    margin-top: 0.8rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-dim);
  }

  .case__film video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    background: #161718;
    border-radius: 3px;
  }

  .viewer {
    position: fixed;
    inset: 0;
    width: calc(100vw - 32px);
    max-width: 2400px;
    height: calc(100svh - 32px);
    max-height: none;
    margin: auto;
    border: 1px solid #ffffff26;
    padding: 20px;
    background: #111213;
    color: #ededeb;
    border-radius: 8px;
    clip-path: inset(0 0 100% 0);
    transform: translateY(14px) scale(0.985);
    transition:
      clip-path 0.32s var(--ease-hover),
      transform 0.32s var(--ease-hover),
      display 0.32s allow-discrete,
      overlay 0.32s allow-discrete;
  }
  .viewer[open] {
    clip-path: inset(0);
    transform: none;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 16px;
  }
  .viewer::backdrop {
    background: #000c;
    backdrop-filter: blur(10px);
    opacity: 0;
    transition:
      opacity 0.32s var(--ease-hover),
      display 0.32s allow-discrete,
      overlay 0.32s allow-discrete;
  }
  .viewer[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .viewer[open] {
      clip-path: inset(100% 0 0 0);
      transform: translateY(14px) scale(0.985);
    }
    .viewer[open]::backdrop {
      opacity: 0;
    }
  }
  .viewer__bar a {
    margin-left: auto;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .viewer__bar a:hover {
    color: #fff;
  }
  .viewer__bar,
  .viewer__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-size: 0.875rem;
  }
  .viewer__bar h2 {
    font-size: 1rem;
    font-weight: 400;
  }
  .viewer button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    min-width: 44px;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid #ffffff40;
    border-radius: 24px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .viewer__previous-icon {
    display: inline-flex;
    rotate: 180deg;
  }
  .viewer button:hover {
    background: #ededeb;
    color: #111;
  }
  .viewer__image {
    display: grid;
    place-items: center;
    min-height: 0;
    transition: opacity 0.2s;
  }
  .viewer[aria-busy='true'] {
    cursor: progress;
  }
  .viewer[aria-busy='true'] .viewer__image {
    opacity: 0.55;
  }
  .viewer__image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .viewer__foot p {
    text-align: center;
    max-width: 65rem;
    line-height: 1.5;
    color: #bdbdbd;
  }
  @media (hover: hover) {
    .case__figure > a:hover :global(img) {
      transform: scale(1.018);
    }
  }
  @media (max-width: 600px) {
    .viewer {
      width: 100vw;
      height: 100svh;
      border: 0;
      border-radius: 0;
      padding: 12px;
    }
    .viewer__bar,
    .viewer__foot {
      gap: 10px;
      font-size: 0.75rem;
    }
    .viewer__bar h2 {
      max-width: none;
      font-size: 0.875rem;
    }
    .viewer__bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'title close' 'original count';
    }
    .viewer__bar h2 {
      grid-area: title;
    }
    .viewer__bar [data-gallery-count] {
      grid-area: count;
      text-align: right;
      white-space: nowrap;
    }
    .viewer__bar a {
      grid-area: original;
      margin-left: 0;
      justify-self: start;
      white-space: nowrap;
    }
    .viewer__bar button {
      grid-area: close;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer,
    .viewer::backdrop,
    .viewer__image,
    .case__figure :global(img),
    .case__enlarge {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .case {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .case__sticky {
      position: static;
    }
  }
</style>
