---
import LogoMark from '@/components/navigation/LogoMark.astro';
import type { Project } from '@/types/content';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<header class="case-hero">
  <div class="case-hero__content">
    <LogoMark size={28} class="case-hero__mark" />
    <p class="case-hero__kind" data-reveal="fade">
      {project.kind}
    </p>
    <h1 class="case-hero__title" data-reveal="lines">
      {project.name}
    </h1>
    <p class="case-hero__tagline" data-reveal="lines" data-reveal-delay="0.2">
      {project.tagline}
    </p>
  </div>
</header>

<style>
  .case-hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 88vh;
    min-height: 88svh;
    overflow: hidden;
    background: var(--color-black);
    text-align: center;
  }

  .case-hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: 6rem var(--gutter) 4rem;
  }

  .case-hero__content :global(.case-hero__mark) {
    color: var(--color-white);
    opacity: 0.9;
  }

  .case-hero__kind {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(255 255 255 / 75%);
  }

  .case-hero__title {
    font-size: var(--fs-hero);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .case-hero__tagline {
    max-width: 34rem;
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.3;
    color: rgb(255 255 255 / 85%);
  }
</style>
