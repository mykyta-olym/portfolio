<div class="cursor-label" data-module="cursor-label" aria-hidden="true">
  <span class="cursor-label__text" data-cursor-text></span>
</div>

<style>
  .cursor-label {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--layer-cursor-label);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-hover) var(--ease-hover);
  }

  .cursor-label__text {
    display: block;
    padding: 10px 14px;
    transform: translate(-50%, -50%) scale(0.8);
    background: var(--color-white);
    color: var(--color-black);
    border-radius: 999px;
    font-size: 20px;
    font-weight: 300;
    line-height: 1.4;
    white-space: nowrap;
    transition: transform var(--duration-hover) var(--ease-hover);
  }

  .cursor-label:global(.is-visible) {
    opacity: 1;
  }

  .cursor-label:global(.is-visible) .cursor-label__text {
    transform: translate(-50%, -50%) scale(1);
  }

  @media (pointer: coarse) {
    .cursor-label {
      display: none;
    }
  }
</style>
