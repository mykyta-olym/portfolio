---
import LogoMark from './LogoMark.astro';
import Icon from '@/components/ui/Icon.astro';
import HoverLink from '@/components/ui/HoverLink.astro';
import { primaryNavigation } from '@/data/navigation';
import { profile } from '@/data/profile';
import { href, isCurrent } from '@/lib/paths';

const current = Astro.url.pathname;
---

<div class="menu" id="site-menu" data-module="menu" hidden>
  <div class="menu__backdrop" data-menu-backdrop></div>
  <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="menu__head">
      <a class="menu__logo" href={href()} aria-label="Mykyta Olym, home">
        <LogoMark size={22} />
      </a>
      <button class="menu__close" type="button" data-menu-close>
        <span class="visually-hidden">Close menu</span>
        <span class="menu__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
    <div class="menu__body" data-menu-surface>
      <nav class="menu__nav" aria-label="Primary">
        <ul>
          {primaryNavigation.map((item) => (
            <li data-menu-item>
              <a class="menu__link" href={href(item.path)} aria-current={isCurrent(current, item.path) ? 'page' : undefined}>
                <HoverLink
                  as="span"
                  align="end"
                  href={href(item.path)}
                  label={item.label}
                  hoverText={item.path === 'contact/' ? 'Hire me' : item.path === 'about/' ? 'Meet' : 'View'}
                />
                <Icon name="arrow-up-right" size={18} class="menu__arrow" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="menu__foot">
        <ul class="menu__social">
          {profile.links.map((link) => (
            <li data-menu-item>
              <HoverLink
                href={link.href}
                label={link.label}
                hoverText={link.hoverText ?? link.label}
                external={!link.href.startsWith('mailto:')}
              />
            </li>
          ))}
        </ul>
        <figure class="menu__media" data-menu-media>
          <video
            data-menu-video
            muted
            loop
            playsinline
            preload="none"
            poster={href('media/menu/code-process-poster.webp')}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={href('media/menu/code-process.mp4')} type="video/mp4" />
          </video>
          <figcaption class="visually-hidden">Source code being edited on a screen</figcaption>
        </figure>
      </div>
    </div>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--layer-menu);
  }

  .menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 48%);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .menu__panel {
    position: absolute;
    top: var(--nav-top);
    bottom: 0;
    left: 50%;
    display: flex;
    flex-direction: column;
    width: var(--nav-width);
    transform: translateX(-50%);
    min-height: 52px;
    background: #000;
    border: 1px solid transparent;
    -webkit-backdrop-filter: blur(18px) brightness(0.4);
    backdrop-filter: blur(18px) brightness(0.4);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .menu__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 50px;
    flex: none;
    padding: 0 5px;
  }

  .menu__body {
    display: flex;
    flex: none;
    height: calc(100dvh - var(--nav-top) - 52px);
    min-height: 0;
    flex-direction: column;
    overflow: hidden auto;
    overscroll-behavior: contain;
  }

  .menu__logo,
  .menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    color: var(--color-white);
  }

  .menu__bars {
    position: relative;
    width: 22px;
    height: 18px;
    transition: scale 0.25s ease-out;
  }

  .menu__bars span {
    position: absolute;
    top: 8px;
    left: 0;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.25s ease-out,
      opacity 0.25s ease-out;
  }

  .menu__bars span:first-child {
    transform: translateY(-4px);
  }
  .menu__bars span:last-child {
    transform: translateY(4px);
  }
  .menu__close:global(.is-open) .menu__bars span:first-child {
    transform: rotate(45deg) scaleX(1.05);
  }
  .menu__close:global(.is-open) .menu__bars span:nth-child(2) {
    opacity: 0;
  }
  .menu__close:global(.is-open) .menu__bars span:last-child {
    transform: rotate(-45deg) scaleX(1.05);
  }
  .menu__close:hover .menu__bars {
    scale: 1.2;
  }

  .menu__nav {
    padding: 66px 44px 0;
  }

  .menu__nav ul {
    display: grid;
    justify-items: end;
    gap: 10px;
  }

  .menu__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-menu);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 30px;
    min-height: 38px;
    color: var(--color-white);
    transition: opacity var(--duration-fast) ease;
  }
  .menu__link :global(.hover-link) {
    min-height: 1.2em;
  }
  .menu__link :global(.hover-link__inner) {
    min-height: 1.2em;
  }

  .menu__link::after {
    content: '';
    position: absolute;
    inset: auto 0 -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-hover) var(--ease-hover);
  }

  .menu__link:is(:hover, :focus-visible)::after {
    transform: scaleX(1);
  }

  .menu__nav ul:hover .menu__link:not(:hover) {
    opacity: 0.75;
  }

  .menu__link[aria-current='page'] {
    opacity: 0.85;
  }

  .menu__link :global(.menu__arrow) {
    width: 30px;
    height: 30px;
    transition: transform var(--duration-hover) var(--ease-hover);
  }

  .menu__link:hover :global(.menu__arrow) {
    transform: translate(2px, -2px);
  }

  .menu__foot {
    margin-top: auto;
    padding: 24px 44px min(12vh, 128px);
  }

  .menu__social {
    display: grid;
    gap: 0;
    margin-bottom: 1.25rem;
    font-size: var(--fs-small);
    font-weight: 300;
    color: #d4d4d4;
  }

  .menu__social a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .menu__social a:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .menu__media {
    position: relative;
    aspect-ratio: 365 / 233;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: linear-gradient(160deg, #2a2a2a, #121212);
  }

  .menu__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-height: 800px) {
    .menu__foot {
      padding-bottom: 24px;
    }
  }

  @media (max-height: 640px) {
    .menu__media {
      display: none;
    }
    .menu__foot {
      padding-bottom: 24px;
    }
    .menu__nav {
      padding-top: 20px;
    }
  }

  @media (max-width: 767px) {
    .menu__nav {
      padding-inline: 36px;
    }
    .menu__nav ul {
      gap: 6px;
    }
    .menu__link {
      line-height: 40px;
      letter-spacing: -0.5px;
    }
    .menu__foot {
      padding-inline: 36px;
    }
    .menu__media {
      aspect-ratio: 275 / 150;
    }
  }
</style>
