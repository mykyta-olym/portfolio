---
import LogoMark from './LogoMark.astro';
import { pillPhrases, primaryNavigation, type PillContext } from '@/data/navigation';
import { href } from '@/lib/paths';

interface Props {
  context: PillContext;
}

const { context } = Astro.props;
const phrase = pillPhrases[context];
const wordWidth = Math.max(...phrase.words.map((word) => word.length));
---

<header class="nav" data-nav>
  <div class="nav__pill">
    <a class="nav__logo" href={href()} aria-label="Mykyta Olym, home">
      <LogoMark size={22} />
    </a>
    <p class="nav__phrase" data-module="typewriter" data-words={JSON.stringify(phrase.words.map((w) => w.toUpperCase()))}>
      {phrase.prefix && <span class="nav__prefix">{phrase.prefix.toUpperCase()}&nbsp;</span>}
      <span class="nav__typing" style={`--type-width:${wordWidth}`}>
        <span data-typewriter-text>{phrase.words[0]?.toUpperCase()}</span>
      </span>
    </p>
    <button class="nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
      <span class="visually-hidden">Open menu</span>
      <span class="nav__lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
    <noscript>
      <nav class="nav__fallback" aria-label="Primary">
        {primaryNavigation.map((item) => (
          <a href={href(item.path)}>{item.label}</a>
        ))}
      </nav>
    </noscript>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: var(--nav-top);
    left: 50%;
    z-index: var(--layer-nav);
    width: var(--nav-width);
    transform: translateX(-50%);
  }

  .nav__pill {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr 2.75rem;
    align-items: center;
    height: 3.25rem;
    padding: 0.3125rem;
    background: rgb(27 27 27 / 88%);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-pill);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .nav__logo,
  .nav__toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    color: var(--color-white);
    transition: background-color var(--duration-fast) ease;
  }

  .nav:global(.is-menu-active) .nav__pill {
    background: #1b1b1b;
  }

  .nav:global(.is-menu-active) .nav__toggle {
    opacity: 0;
  }

  .nav__toggle:hover .nav__lines {
    transform: scale(1.2);
  }

  .nav__phrase {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 400;
    letter-spacing: 0.15em;
    line-height: 1;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .nav__phrase :global(.typed-cursor) {
    display: inline-block;
    width: 0.3125rem;
    height: 0.625rem;
    margin-left: 0.1875rem;
    background: var(--color-white);
    color: transparent;
    flex: none;
  }

  .nav__typing {
    display: inline-block;
    flex: none;
    width: calc(var(--type-width) * (1ch + 0.15em) + 0.5rem);
    text-align: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .nav__phrase:not(:global(.is-typing)) [data-typewriter-text] {
      visibility: hidden;
    }
  }

  .nav__lines {
    display: grid;
    gap: 2px;
    width: 22px;
    transition: transform 0.25s ease-out;
  }

  .nav__lines span {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }

  .nav__fallback {
    position: absolute;
    inset: 0 3.25rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    background: rgb(20 20 20 / 92%);
    font-size: var(--fs-small);
  }

  :global(.no-js) .nav__toggle,
  :global(.no-js) .nav__phrase {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__typing {
      width: auto;
    }
    :global(.js) .nav__phrase [data-typewriter-text] {
      visibility: visible;
    }
    .nav__phrase :global(.typed-cursor) {
      animation: none;
    }
  }
</style>
