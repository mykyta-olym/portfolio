---
import SectionLabel from '@/components/ui/SectionLabel.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { questions } from '@/data/faq';
import { href } from '@/lib/paths';
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__lead">
    <h2 class="cta__title" id="cta-title" data-reveal="lines">
      Let's build something that works
    </h2>
    <p class="cta__text" data-reveal="fade">
      Have a project, a role or a question about my code? Write to me.
    </p>
    <div data-reveal="fade" data-reveal-delay="0.15">
      <Button href={href('contact/')} hoverText="Let's talk">
        Get in Touch
      </Button>
    </div>
  </div>
  <div class="cta__faq">
    <SectionLabel text="FAQ" />
    <div class="faq">
      {questions.map((item) => (
        <details class="faq__item" data-reveal="fade">
          <summary class="faq__question">
            <span>{item.question}</span>
            <Icon name="chevron-down" size={14} class="faq__icon" />
          </summary>
          <div class="faq__answer" data-faq-body>
            {item.answer.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 43.4vw) minmax(0, 1fr);
    gap: 3vw;
    padding: clamp(5rem, 10.4vw, 10rem) calc(var(--gutter) + 1.1vw) clamp(5.5rem, 10vw, 10rem) var(--gutter);
    background: var(--color-surface);
  }

  .cta__lead {
    padding-top: clamp(1rem, 3.8vw, 4rem);
  }

  .cta__title {
    max-width: 12em;
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    color: #dadada;
  }

  .cta__text {
    margin: clamp(1.75rem, 3.6vw, 3.5rem) 0 1.25rem;
    font-size: var(--fs-body);
    font-weight: 300;
    color: var(--color-white);
  }

  .faq {
    margin-top: 1.75rem;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
  }

  .faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #dedede;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--color-white);
  }

  .faq__question :global(.faq__icon) {
    flex: none;
    transition: transform 0.4s var(--ease-in-out);
  }

  .faq__item[open] :global(.faq__icon) {
    transform: rotate(180deg);
  }

  @supports (interpolate-size: allow-keywords) and selector(::details-content) {
    .faq__item {
      interpolate-size: allow-keywords;
    }
    .faq__item::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.42s cubic-bezier(0.65, 0, 0.35, 1),
        content-visibility 0.42s allow-discrete;
    }
    .faq__item[open]::details-content {
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item::details-content,
    .faq__question :global(.faq__icon) {
      transition: none;
    }
  }

  .faq__answer {
    display: grid;
    gap: 0.75rem;
    padding: 0 2rem 1.4rem 0;
    font-family: var(--font-tight);
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .cta {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding-right: var(--gutter);
    }
  }
</style>
