---
import { Image } from 'astro:assets';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { disciplines } from '@/data/disciplines';
---

<section class="disciplines" data-module="disciplines" aria-labelledby="disciplines-label" style={`--count: ${disciplines.length}`}>
  <div class="disciplines__sticky">
    <SectionLabel text="What I do" class="disciplines__label" />
    <h2 class="visually-hidden" id="disciplines-label">
      What I do
    </h2>
    <ol class="disciplines__list">
      {disciplines.map((item, index) => (
        <li class:list={['disciplines__item', { 'is-active': index === 0 }]} data-discipline-item>
          <h3 class="disciplines__title">{item.title}</h3>
        </li>
      ))}
    </ol>
    <div class="disciplines__media">
      {disciplines.map((item, index) => (
        <figure class:list={['disciplines__figure', { 'is-active': index === 0 }]} data-discipline-image>
          <div class="disciplines__picture">
            <Image src={item.image.src} alt={item.image.alt} widths={[480, 960]} sizes="(min-width: 1024px) 32vw, 80vw" loading="lazy" />
          </div>
          <figcaption class="disciplines__description">{item.description}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .disciplines {
    position: relative;
    height: calc(100vh + var(--count) * 30vh);
    background: var(--color-black);
  }

  .disciplines__sticky {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 32vw);
    grid-template-rows: auto 1fr;
    align-items: center;
    column-gap: 4vw;
    height: 100vh;
    padding: 18vh calc(var(--gutter) + 1.9vw) 12vh 11.1vw;
  }

  .disciplines__sticky :global(.disciplines__label) {
    grid-column: 1 / -1;
    align-self: start;
    margin-left: -6.25vw;
  }

  .disciplines__list {
    display: grid;
    gap: 0.15em;
    align-self: center;
  }

  /* Dimmed lines keep 3:1 contrast, the AA minimum for large text. */
  .disciplines__item {
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .disciplines__item:global(.is-active) {
    opacity: 1;
  }

  .disciplines__title {
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-white);
  }

  /* All figures share one grid cell, so swapping them never changes the layout. */
  .disciplines__media {
    display: grid;
    align-self: center;
  }

  .disciplines__figure {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .disciplines__figure:global(.is-active) {
    opacity: 1;
  }

  .disciplines__picture {
    aspect-ratio: 464 / 300;
    overflow: hidden;
    border-radius: 3px;
  }

  .disciplines__picture :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
    transition: transform 0.6s var(--ease-out);
  }

  .disciplines__figure:global(.is-active) .disciplines__picture :global(img) {
    transform: none;
  }

  .disciplines__description {
    max-width: 26rem;
    margin-top: 0.9rem;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  @media (max-width: 1023px) {
    .disciplines__sticky {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      align-content: center;
      row-gap: 2rem;
      padding: 14vh var(--gutter) 8vh;
    }

    .disciplines__sticky :global(.disciplines__label) {
      margin-left: 0;
    }

    .disciplines__media {
      width: min(100%, 26rem);
      justify-self: end;
    }
  }

  /* A landscape viewport still needs room below the fixed navigation. */
  @media (max-height: 640px) and (min-width: 640px) {
    .disciplines__sticky {
      grid-template-columns: minmax(0, 1fr) minmax(0, 40%);
      grid-template-rows: auto minmax(0, 1fr);
      align-content: normal;
      gap: 1rem 4vw;
      padding: 5.75rem var(--gutter) 1.5rem;
    }

    .disciplines__sticky :global(.disciplines__label) {
      margin-left: 0;
    }

    .disciplines__title {
      font-size: clamp(1.375rem, 8vh, 2.75rem);
    }

    .disciplines__media {
      width: 100%;
    }

    .disciplines__picture {
      height: min(35vh, 12rem);
      aspect-ratio: auto;
    }

    .disciplines__picture :global(img) {
      object-fit: contain;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disciplines__item,
    .disciplines__figure,
    .disciplines__picture :global(img) {
      transition: none;
    }
  }
</style>
