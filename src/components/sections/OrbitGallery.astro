---
import { Image } from 'astro:assets';
import { galleryCards } from '@/data/disciplines';
import Icon from '@/components/ui/Icon.astro';
---

<section class="orbit" data-module="orbit-gallery" aria-labelledby="orbit-title">
  <div class="orbit__stage">
    <div class="orbit__heading" data-orbit-heading>
      <h2 class="orbit__title" id="orbit-title">
        From idea to release
      </h2>
      <p class="orbit__meta">
        <span class="orbit__pointer-hint">Six steps // Hover or tap to turn</span>
        <span class="orbit__touch-hint">Six steps // Select to read</span>
      </p>
    </div>
    <ul class="orbit__ring" data-orbit-ring>
      {galleryCards.map((card, index) => {
        const angle = (index * Math.PI * 2) / galleryCards.length - Math.PI / 4;
        return (
          <li
            class="orbit__slot"
            style={`--dx:${Math.cos(angle)};--dy:${Math.sin(angle)};--angle:${(angle * 180) / Math.PI + 90}deg;z-index:${index + 1}`}
          >
            <button class="orbit__card" type="button" data-orbit-card aria-expanded="false" aria-label={`${card.title}: ${card.text}`}>
              <span class="orbit__flip">
                <span class="orbit__face orbit__front" aria-hidden="true">
                  <Image
                    src={card.image}
                    alt=""
                    widths={[240, 420]}
                    sizes="(min-width: 768px) 240px, 110px"
                    class="orbit__image"
                    style={`object-position: ${card.position ?? '50% 50%'}`}
                    loading="lazy"
                  />
                  <span class="orbit__caption">
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    {card.title}
                    <Icon name="arrow-up-right" size={14} />
                  </span>
                </span>
                <span class="orbit__face orbit__back" aria-hidden="true">
                  <span class="orbit__number">
                    {String(index + 1).padStart(2, '0')} / {card.title}
                    <Icon name="close" size={12} />
                  </span>
                  <span class="orbit__explanation">{card.text}</span>
                  <span class="orbit__source">{card.source}</span>
                </span>
              </span>
            </button>
          </li>
        );
      })}
    </ul>
    <noscript>
      <ol class="orbit__plain">
        {galleryCards.map((card) => (
          <li>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </li>
        ))}
      </ol>
    </noscript>
  </div>
</section>

<style>
  .orbit {
    position: relative;
    background: var(--color-black);
  }

  .orbit__stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 100vh;
    min-height: 34rem;
    overflow: hidden;
    --ring-radius: min(350px, 32vw, max(174px, 32vh));
  }

  .orbit__heading {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: min(260px, 28vw, 36vh);
    text-align: center;
    pointer-events: none;
  }

  /* GSAP owns the entrance; CSS fades the heading only while reading a card. */
  .orbit:global(.is-interactive) .orbit__heading {
    transition: opacity 0.3s var(--ease-hover);
  }

  .orbit__title {
    font-family: var(--font-tight);
    font-size: var(--fs-gallery);
    font-weight: 400;
    letter-spacing: -0.006em;
    line-height: 1.12;
    color: #dcdcdc;
  }

  .orbit__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .orbit__touch-hint {
    display: none;
  }

  .orbit__ring {
    position: absolute;
    inset: 0;
    transform-style: flat;
    z-index: 2;
  }

  /* Each slot is an independent, opaque plane. Flattening the slots prevents the
     coplanar cards from cutting through each other during the source's stacked entry. */
  .orbit__slot {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1000px;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-hover);
  }

  .orbit__card {
    display: block;
    width: min(240px, 20vw, 28vh);
    aspect-ratio: 1.5;
    border-radius: 5px;
    overflow: visible;
    background: transparent;
    pointer-events: auto;
    transform-style: flat;
    transform: translate(calc(var(--dx) * var(--ring-radius)), calc(var(--dy) * var(--ring-radius)));
    will-change: transform;
    transition: width 0.5s var(--ease-hover);
    -webkit-tap-highlight-color: transparent;
    --open-width: min(300px, 72vw);
  }
  .orbit:global(.has-expanded) .orbit__slot {
    opacity: 0.18;
  }
  .orbit:global(.has-expanded) .orbit__heading {
    opacity: 0 !important;
  }
  .orbit__slot:has([aria-expanded='true']) {
    z-index: 20 !important;
    opacity: 1 !important;
  }
  .orbit__card[aria-expanded='true'] {
    width: var(--open-width);
    aspect-ratio: 1.1;
  }
  .orbit__card[aria-expanded='true'] .orbit__back {
    padding: 1.25rem;
  }
  .orbit__card[aria-expanded='true'] .orbit__explanation {
    font-size: 20px;
  }
  .orbit__card[aria-expanded='true'] .orbit__number {
    font-size: 11px;
  }
  .orbit__flip {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-hover);
  }
  .orbit__face {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 5px;
  }
  .orbit__front {
    background: #151515;
  }
  .orbit__back {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.1rem;
    background: #e7e7e2;
    color: #141414;
    transform: rotateY(180deg);
    text-align: left;
  }
  .orbit__number {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .orbit__explanation {
    font-size: clamp(11px, 1vw, 14px);
    line-height: 1.2;
    font-weight: 400;
  }
  .orbit__source {
    font-family: var(--font-mono);
    font-size: 9px;
    opacity: 0.7;
  }
  .orbit__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: linear-gradient(transparent, #000);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
  }
  .orbit__caption > :first-child {
    font: 10px var(--font-mono);
  }
  .orbit__caption > :last-child {
    margin-left: auto;
  }
  .orbit__card[aria-expanded='true'] .orbit__flip {
    transform: rotateY(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .orbit:global(.is-interactive) .orbit__card:hover .orbit__flip {
      transform: rotateY(180deg);
    }
  }

  .orbit__card :global(.orbit__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  :global(.no-js) .orbit__ring {
    display: none;
  }
  :global(.no-js) .orbit__stage {
    height: auto;
    min-height: 0;
    padding: 5rem var(--gutter);
    gap: 2rem;
  }
  :global(.no-js) .orbit__heading {
    max-width: none;
  }
  :global(.no-js) .orbit__meta {
    display: none;
  }
  .orbit__plain {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 2rem;
    max-width: 70rem;
  }
  .orbit__plain h3 {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
  }
  .orbit__plain p {
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  :global(.js) .orbit:not(:global(.is-static)) .orbit__card {
    transform: none;
    opacity: 0;
  }

  :global(.js) .orbit:not(:global(.is-static)) .orbit__ring:global(.is-built) .orbit__card,
  :global(.js) .orbit:not(:global(.is-static)) .orbit__card[style] {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .orbit__stage {
      height: 100svh;
      --ring-radius: 124px;
    }
    .orbit__card {
      width: min(104px, 26vw);
      aspect-ratio: 1.25;
    }
    .orbit__back {
      padding: 0.65rem;
    }
    .orbit__number {
      font-size: 8px;
      letter-spacing: 0;
    }
    .orbit__explanation {
      font-size: 11px;
    }
    .orbit__caption {
      padding: 0.5rem;
      font-size: 11px;
      gap: 0.3rem;
    }
    .orbit__caption > :first-child,
    .orbit__caption :global(svg) {
      display: none;
    }
    .orbit__heading {
      max-width: 115px;
      gap: 0.5rem;
    }
    .orbit__meta {
      max-width: 130px;
      font-size: 9px;
      line-height: 1.3;
    }
    .orbit__title {
      font-size: 21px;
    }
    .orbit__card[aria-expanded='false']:is(:hover, :focus-visible) .orbit__flip {
      transform: none;
    }
  }
  @media (max-width: 1023px) {
    .orbit__card[aria-expanded='false']:is(:hover, :focus-visible) .orbit__flip {
      transform: none;
    }
  }
  @media (max-height: 640px) {
    .orbit__card[aria-expanded='false']:is(:hover, :focus-visible) .orbit__flip {
      transform: none;
    }
  }
  @media (max-height: 640px) and (min-width: 640px) {
    .orbit__stage {
      height: 100svh;
      min-height: 0;
      padding-top: 5rem;
    }
    .orbit__ring {
      inset: 5rem 0 0;
    }
    .orbit__card {
      width: 90px;
      aspect-ratio: 1.5;
    }
    .orbit__heading {
      max-width: 115px;
      gap: 0.5rem;
    }
    .orbit__title {
      font-size: 21px;
    }
    .orbit__meta {
      font-size: 9px;
      line-height: 1.3;
    }
    .orbit__caption {
      padding: 0.5rem;
      font-size: 11px;
    }
    .orbit__caption > :first-child,
    .orbit__caption :global(svg) {
      display: none;
    }
  }
  @media (max-width: 767px), (max-height: 640px), (pointer: coarse), (hover: none) {
    .orbit__pointer-hint {
      display: none;
    }
    .orbit__touch-hint {
      display: inline;
    }
  }
  @media (pointer: coarse), (hover: none) {
    /* Touch cards reveal their explanation without a compositor-dependent 3D backface. */
    .orbit__card[aria-expanded] .orbit__flip {
      transform: none;
      transform-style: flat;
    }
    .orbit__face {
      transition:
        opacity var(--duration-hover) var(--ease-hover),
        visibility var(--duration-hover) var(--ease-hover);
    }
    /* The explanation is laid out once at the opened size and the card opens over it like a
       window, so no line reflows while the card grows. */
    .orbit__flip {
      overflow: hidden;
      border-radius: 5px;
    }
    .orbit__back {
      inset: auto;
      top: 50%;
      left: 50%;
      width: var(--open-width);
      height: calc(var(--open-width) / 1.1);
      padding: 1.25rem;
      transform: translate(-50%, -50%);
      opacity: 0;
      visibility: hidden;
    }
    .orbit__back .orbit__explanation {
      font-size: 20px;
    }
    .orbit__back .orbit__number {
      font-size: 11px;
      letter-spacing: 0.08em;
    }
    .orbit__card[aria-expanded='true'] .orbit__front {
      opacity: 0;
      visibility: hidden;
    }
    .orbit__back > * {
      opacity: 0;
      transition: opacity var(--duration-hover) var(--ease-hover);
    }
    .orbit__card[aria-expanded='true'] .orbit__back {
      opacity: 1;
      visibility: visible;
    }
    /* The paper comes in with the opening; the text waits until the window is mostly open.
       Closing fades both out at once. */
    .orbit__card[aria-expanded='true'] .orbit__back > * {
      opacity: 1;
      transition-delay: 0.3s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit__flip,
    .orbit__card,
    .orbit__slot,
    .orbit__heading {
      transition: none;
    }
  }
</style>
