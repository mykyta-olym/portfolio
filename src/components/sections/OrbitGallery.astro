---
import { Image } from 'astro:assets';
import { galleryCards } from '@/data/disciplines';
import { projectBySlug } from '@/data/projects';
import { projectHref } from '@/lib/paths';
---

<section class="orbit" data-module="orbit-gallery" aria-labelledby="orbit-title">
  <div class="orbit__stage">
    <div class="orbit__heading" data-orbit-heading>
      <h2 class="orbit__title" id="orbit-title">
        Built in public
      </h2>
      <p class="orbit__meta">2026 // Selected work</p>
    </div>
    <ul class="orbit__ring" data-orbit-ring>
      {galleryCards.map((card, index) => {
        const project = projectBySlug(card.slug);
        const angle = (index * Math.PI * 2) / galleryCards.length - Math.PI / 4;
        return (
          <li
            class="orbit__slot"
            style={`--dx:${Math.cos(angle)};--dy:${Math.sin(angle)};--angle:${(angle * 180) / Math.PI + 90}deg;z-index:${index + 1}`}
          >
            <a class="orbit__card" data-orbit-card href={projectHref(project.slug)} aria-label={`${project.name} case study`}>
              <Image
                src={card.image.src}
                alt=""
                widths={[240, 420]}
                sizes="(min-width: 768px) 14vw, 32vw"
                class="orbit__image"
                loading="lazy"
              />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .orbit {
    position: relative;
    background: var(--color-black);
  }

  .orbit__stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 100vh;
    min-height: 34rem;
    overflow: hidden;
    --ring-radius: min(280px, 34vw);
  }

  .orbit__heading {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    pointer-events: none;
  }

  .orbit__title {
    font-family: var(--font-tight);
    font-size: var(--fs-gallery);
    font-weight: 400;
    letter-spacing: -0.006em;
    line-height: 1.12;
    color: #dcdcdc;
  }

  .orbit__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .orbit__ring {
    position: absolute;
    inset: 0;
    transform-style: flat;
  }

  /* Each slot is an independent, opaque plane. Flattening the slots prevents the
     coplanar cards from cutting through each other during the source's stacked entry. */
  .orbit__slot {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1000px;
    pointer-events: none;
  }

  .orbit__card {
    display: block;
    width: min(205px, 26vw);
    aspect-ratio: 205 / 120;
    border-radius: 5px;
    overflow: hidden;
    background: #0b0b0c;
    pointer-events: auto;
    transform-style: flat;
    transform: translate(calc(var(--dx) * var(--ring-radius)), calc(var(--dy) * var(--ring-radius))) rotate(var(--angle));
    will-change: transform;
  }

  .orbit__card :global(.orbit__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  :global(.js) .orbit:not(:global(.is-static)) .orbit__card {
    transform: none;
    opacity: 0;
  }

  :global(.js) .orbit:not(:global(.is-static)) .orbit__ring:global(.is-built) .orbit__card,
  :global(.js) .orbit:not(:global(.is-static)) .orbit__card[style] {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .orbit__title {
      font-size: 25px;
    }
  }
</style>
