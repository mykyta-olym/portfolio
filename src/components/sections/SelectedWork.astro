---
import ProjectRow from '@/components/projects/ProjectRow.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import InlinePic from '@/components/ui/InlinePic.astro';
import Button from '@/components/ui/Button.astro';
import { featuredProjects } from '@/data/projects';
import { href } from '@/lib/paths';
---

<section class="work" aria-labelledby="work-title">
  <div class="work__intro">
    <SectionLabel text="Selected work" class="work__label" />
    <h2 class="visually-hidden" id="work-title">
      Selected work
    </h2>
    <p class="work__statement" data-scroll-rise>
      Everything here is public. The code, the tests and the numbers <InlinePic variant="convert" /> are in each repository, including the
      results that did not go my way.
    </p>
  </div>
  <div class="work__rows">
    {featuredProjects.map((project) => (
      <ProjectRow project={project} />
    ))}
  </div>
  <div class="work__more">
    <Button href={href('work/')} variant="dark" hoverText="Explore all six">
      All Projects
    </Button>
  </div>
</section>

<style>
  .work {
    position: relative;
    background: var(--color-surface);
    padding-top: clamp(4.5rem, 9.8vw, 9.5rem);
  }

  .work__intro {
    display: grid;
    grid-template-columns: 19.6vw minmax(0, 58.6vw);
    padding: 0 var(--gutter) clamp(3rem, 9.4vw, 8.5rem) var(--gutter);
  }

  .work__intro :global(.work__label) {
    align-self: start;
    margin-top: 0.5rem;
  }

  .work__statement {
    font-size: var(--fs-statement);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-statement);
    color: var(--color-text-soft);
  }

  .work__rows {
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }

  .work__more {
    display: flex;
    justify-content: center;
    padding-block: clamp(1.25rem, 1.4vw, 1.5rem);
  }

  @media (max-width: 1023px) {
    .work__intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
