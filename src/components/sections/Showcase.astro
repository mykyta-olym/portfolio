---
import { Image } from 'astro:assets';
import showcase from '@/assets/renders/showcase.webp';
---

<section class="showcase" data-module="showcase" aria-labelledby="showcase-title">
  <div class="showcase__wrapper">
    <div class="showcase__frame" data-showcase-frame>
      <Image
        src={showcase}
        alt="A laptop on dark basalt shows Mykyta Olym's portrait and software developer portfolio."
        widths={[960, 1600, 2400]}
        sizes="100vw"
        class="showcase__image"
        loading="lazy"
      />
      <div class="showcase__content">
        <h2 class="showcase__title" id="showcase-title" data-showcase-content>
          Design. Build. Measure.
        </h2>
        <p class="showcase__text" data-showcase-content>
          I design the system, build it in small tested parts, and measure it before I write about it.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Desktop: the frame sticks for one viewport of scrolling while it shrinks.
     Sticky positioning keeps the layout still, so the pin causes no layout shift. */
  .showcase {
    position: relative;
    height: 200vh;
    background: var(--color-surface);
  }

  .showcase__wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .showcase__frame {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #020101;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .showcase__frame :global(.showcase__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase__content {
    position: relative;
    display: grid;
    justify-items: center;
    padding: clamp(4rem, 9vh, 6rem) 10.4vw 0;
    text-align: center;
  }

  .showcase__title {
    font-size: var(--fs-banner);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-white);
  }

  .showcase__text {
    max-width: 40rem;
    margin-top: 1.2rem;
    font-size: var(--fs-banner-sub);
    font-weight: 300;
    line-height: 1.4;
    color: #dadada;
  }

  :global(.js) .showcase:not(:global(.is-static)) [data-showcase-content] {
    opacity: 0;
  }

  .showcase:global(.is-static) {
    height: auto;
  }

  .showcase:global(.is-static) .showcase__frame {
    transform: scale(0.8);
    border-radius: 4px;
  }

  @media (max-width: 767px), (max-height: 640px) {
    .showcase {
      height: 145svh;
    }
    .showcase__wrapper {
      height: 100svh;
    }
    .showcase__content {
      padding-top: 5.5rem;
    }
    .showcase:global(.is-static) {
      height: auto;
    }
  }
  @media (max-width: 767px) {
    .showcase__frame :global(.showcase__image) {
      /* Keep the complete laptop screen inside the portrait frame. Only the empty
         sides of the landscape artwork extend beyond it. */
      inset: 15% auto 0 -45%;
      width: 160%;
      max-width: none;
      height: 85%;
      object-fit: contain;
    }
  }
</style>
