---
import { href } from '@/lib/paths';

const tools = [
  ['go', 'Go'],
  ['python', 'Python'],
  ['typescript', 'TypeScript'],
  ['redis', 'Redis'],
  ['postgresql', 'PostgreSQL'],
  ['fastapi', 'FastAPI'],
  ['docker', 'Docker'],
  ['github', 'GitHub'],
];
---

<div class="marquee swiper" data-module="marquee" aria-label="Tools used in these projects">
  <ul class="marquee__track swiper-wrapper">
    {tools.map(([icon, label]) => (
      <li class="marquee__item swiper-slide">
        <img src={href(`media/tools/${icon}.svg`)} width="48" height="48" alt="" loading="lazy" />
        <span>{label}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(4rem, 11.3vw, 10.5rem);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee__track {
    align-items: center;
    transition-timing-function: linear !important;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: calc(100% / 6);
    flex: 0 0 auto;
    font-family: var(--font-tight);
    font-size: clamp(0.875rem, 1.2vw, 1.25rem);
    font-weight: 500;
    color: #d0d0d0;
    white-space: nowrap;
  }

  .marquee__item img {
    width: clamp(1.5rem, 2.8vw, 3rem);
    height: clamp(1.5rem, 2.8vw, 3rem);
    object-fit: contain;
  }

  @media (max-width: 767px) {
    .marquee__item {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
