---
// Tools that appear in the featured repositories. Text, not logos.
const tools = [
  'Go',
  'Python',
  'TypeScript',
  'Redis',
  'PostgreSQL',
  'FastAPI',
  'PyTorch',
  'LightGBM',
  'Docker',
  'Prometheus',
  'Phaser',
  'GitHub Actions',
];
---

<div class="marquee" aria-label="Tools used in these projects">
  <ul class="marquee__track">
    {tools.map((tool) => (
      <li class="marquee__item">{tool}</li>
    ))}
    {tools.map((tool) => (
      <li class="marquee__item" aria-hidden="true">
        {tool}
      </li>
    ))}
  </ul>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(4rem, 11.3vw, 10.5rem);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 46s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    padding-inline: clamp(1.75rem, 3.4vw, 3.5rem);
    font-family: var(--font-tight);
    font-size: clamp(1rem, 1.35vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #8b8b8b;
    white-space: nowrap;
  }

  .marquee__item::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    margin-right: clamp(1.75rem, 3.4vw, 3.5rem);
    margin-left: calc(-1 * clamp(1.75rem, 3.4vw, 3.5rem));
    background: #3a3a3a;
  }

  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
