---
import { Image } from 'astro:assets';
import avatar from '@/assets/profile/avatar.jpg';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a class:list={['avatar-button', className]} href={href}>
  <Image src={avatar} alt="" width={64} height={64} class="avatar-button__image" loading="eager" />
  <span>
    <slot />
  </span>
</a>

<style>
  .avatar-button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    height: 3.25rem;
    padding: 0.5rem 1.25rem 0.5rem 0.5rem;
    background: rgb(255 255 255 / 71%);
    color: var(--color-black);
    border-radius: 3px;
    font-size: var(--fs-small);
    font-weight: 400;
    white-space: nowrap;
    transition: transform 0.4s ease;
  }

  .avatar-button:hover,
  .avatar-button:focus-visible {
    transform: translateY(-6px) scale(1.02);
  }

  .avatar-button :global(.avatar-button__image) {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 2px;
    object-fit: cover;
    filter: grayscale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-button {
      transition: none;
    }
    .avatar-button:hover,
    .avatar-button:focus-visible {
      transform: none;
    }
  }
</style>
