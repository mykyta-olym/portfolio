---
import { Image } from 'astro:assets';
import avatar from '@/assets/profile/avatar.jpg';

interface Props {
  href: string;
  class?: string;
  hoverText?: string;
}

const { href, class: className, hoverText = 'Hire me' } = Astro.props;
---

<a class:list={['avatar-button', className]} href={href}>
  <Image src={avatar} alt="" width={64} height={64} class="avatar-button__image" loading="eager" />
  <span class="avatar-button__labels" data-hover-text={hoverText}>
    <span class="avatar-button__label">
      <slot />
    </span>
    <span class="avatar-button__next" aria-hidden="true">
      {hoverText}
    </span>
  </span>
</a>

<style>
  .avatar-button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    height: 3.25rem;
    padding: 0.5rem 1.25rem 0.5rem 0.5rem;
    background: rgb(255 255 255 / 71%);
    color: var(--color-black);
    border-radius: 3px;
    font-size: var(--fs-small);
    font-weight: 400;
    white-space: nowrap;
    transition: background-color var(--duration-hover) var(--ease-hover);
  }

  .avatar-button:hover,
  .avatar-button:focus-visible {
    background: #fff;
  }

  .avatar-button :global(.avatar-button__image) {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 2px;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      filter var(--duration-hover) var(--ease-hover),
      clip-path var(--duration-hover) var(--ease-hover);
    clip-path: inset(0 round 2px);
  }

  .avatar-button:is(:hover, :focus-visible) :global(.avatar-button__image) {
    filter: grayscale(0);
    clip-path: inset(0 round 18px);
  }
  .avatar-button__labels {
    position: relative;
    display: grid;
    overflow: hidden;
    line-height: 1.6;
  }
  .avatar-button__labels::after {
    content: attr(data-hover-text);
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .avatar-button__label {
    grid-area: 1 / 1;
  }
  .avatar-button__next {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .avatar-button__label,
  .avatar-button__next {
    transition: transform var(--duration-hover) var(--ease-hover);
  }
  .avatar-button:is(:hover, :focus-visible) .avatar-button__label {
    transform: translateY(-100%);
  }
  .avatar-button:is(:hover, :focus-visible) .avatar-button__next {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-button,
    .avatar-button__label,
    .avatar-button__next,
    .avatar-button :global(.avatar-button__image) {
      transition: none;
    }
    .avatar-button:hover,
    .avatar-button:focus-visible {
      transform: none;
    }
  }
</style>
