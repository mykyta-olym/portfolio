---
interface Props {
  href: string;
  variant?: 'light' | 'dark';
  external?: boolean;
  class?: string;
  hoverText?: string;
}

const { href, variant = 'light', external = false, class: className, hoverText } = Astro.props;
---

<a
  class:list={['button', `button--${variant}`, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span class="button__label">
    <span class="button__text" data-hover-text={hoverText}>
      <span class="button__original">
        <slot />
      </span>
      {hoverText && (
        <span class="button__next" aria-hidden="true">
          {hoverText}
        </span>
      )}
    </span>
  </span>
  <svg class="button__icon" width="12" height="16" viewBox="0 0 19 24" fill="currentColor" aria-hidden="true">
    <rect x="0.5" y="0.75" width="8" height="6" rx="0.45" />
    <rect x="5" y="4.75" width="8" height="6" rx="0.45" />
    <rect x="9.5" y="9" width="8" height="6" rx="0.45" />
    <rect x="5" y="13.25" width="8" height="6" rx="0.45" />
    <rect x="0.5" y="17.25" width="8" height="6" rx="0.45" />
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.75rem;
    padding: 0 10px 0 30px;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: -0.006em;
    white-space: nowrap;
    overflow: hidden;
    transition:
      background-color var(--duration-hover) var(--ease-hover),
      color var(--duration-hover) var(--ease-hover),
      border-color var(--duration-hover) var(--ease-hover);
  }

  .button__label {
    display: block;
    transform: translate3d(-10px, 0, 0);
    transition: transform var(--duration-hover) var(--ease-hover);
  }

  .button :global(.button__icon) {
    flex: none;
    transform: translate3d(-10px, 0, 0);
    transition: transform var(--duration-hover) var(--ease-hover);
  }
  .button__text {
    position: relative;
    display: grid;
    line-height: 1.5;
    overflow: hidden;
  }
  .button__text::after {
    content: attr(data-hover-text);
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .button__original {
    grid-area: 1 / 1;
  }
  .button__next {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .button__original,
  .button__next {
    transition: transform var(--duration-hover) var(--ease-hover);
  }
  .button:is(:hover, :focus-visible) .button__text[data-hover-text] .button__original {
    transform: translateY(-100%);
  }
  .button:is(:hover, :focus-visible) .button__next {
    transform: translateY(0);
  }

  .button:hover .button__label,
  .button:focus-visible .button__label {
    transform: translate3d(0, 0, 0);
  }

  .button:hover :global(.button__icon),
  .button:focus-visible :global(.button__icon) {
    transform: translate3d(0, 0, 0);
  }

  .button--light {
    background: var(--color-white);
    color: var(--color-black);
  }

  .button--light:hover,
  .button--light:focus-visible {
    background: #deded8;
    color: #101110;
    border-color: #fff;
  }

  .button--dark {
    background: #262826;
    color: var(--color-white);
    border-color: rgb(255 255 255 / 22%);
  }

  .button--dark:hover,
  .button--dark:focus-visible {
    background: #e8e8e2;
    color: var(--color-black);
    border-color: var(--color-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .button__label,
    .button__original,
    .button__next,
    .button :global(.button__icon) {
      transition: none;
    }
  }
</style>
