---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'light' | 'dark';
  external?: boolean;
  class?: string;
}

const { href, variant = 'light', external = false, class: className } = Astro.props;
---

<a
  class:list={['button', `button--${variant}`, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span class="button__label">
    <slot />
  </span>
  <Icon name="chevron-right" size={11} class="button__icon" />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    height: 2.5rem;
    padding: 0 1.125rem 0 1.25rem;
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: var(--fs-small);
    font-weight: 400;
    letter-spacing: -0.006em;
    white-space: nowrap;
    transition:
      background-color 0.3s var(--ease-button),
      color 0.3s var(--ease-button),
      border-color 0.3s var(--ease-button);
  }

  .button__label {
    display: block;
    transition: transform 0.3s var(--ease-button);
  }

  .button :global(.button__icon) {
    transition: transform 0.3s var(--ease-button);
  }

  .button:hover .button__label,
  .button:focus-visible .button__label {
    transform: translateX(-3px);
  }

  .button:hover :global(.button__icon),
  .button:focus-visible :global(.button__icon) {
    transform: translateX(4px);
  }

  .button--light {
    background: var(--color-white);
    color: var(--color-black);
  }

  .button--light:hover,
  .button--light:focus-visible {
    background: transparent;
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .button--dark {
    background: var(--color-black);
    color: var(--color-white);
    border-color: rgb(255 255 255 / 22%);
  }

  .button--dark:hover,
  .button--dark:focus-visible {
    background: var(--color-white);
    color: var(--color-black);
    border-color: var(--color-white);
  }
</style>
