---
import Icon from './Icon.astro';

interface Props {
  count: number;
}
const { count } = Astro.props;
---

<div class="gallery-controls" data-gallery-controls>
  <span class="gallery-controls__hint">Swipe to explore</span>
  <div class="gallery-controls__actions">
    <button class="gallery-controls__previous" type="button" data-slide-prev aria-label="Previous image">
      <Icon name="chevron-right" size={18} />
    </button>
    <span class="gallery-controls__count" data-slide-count>
      1 / {count}
    </span>
    <button type="button" data-slide-next aria-label="Next image">
      <Icon name="chevron-right" size={18} />
    </button>
  </div>
</div>

<style>
  .gallery-controls {
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }
  .gallery-controls__hint,
  .gallery-controls__count {
    font-family: var(--font-label);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .gallery-controls__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gallery-controls button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    color: var(--color-white);
    transition:
      opacity 0.2s,
      background-color 0.2s;
  }
  .gallery-controls button:active {
    background: rgb(255 255 255 / 12%);
  }
  .gallery-controls button:disabled {
    opacity: 0.3;
  }
  .gallery-controls__previous :global(svg) {
    rotate: 180deg;
  }
  .gallery-controls__count {
    min-width: 3rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  :global(.no-js) .gallery-controls__actions {
    display: none;
  }
  @media (max-width: 767px), (pointer: coarse) {
    .gallery-controls {
      display: flex;
    }
  }
</style>
