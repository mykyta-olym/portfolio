---
interface Props {
  href: string;
  label: string;
  hoverText?: string;
  external?: boolean;
  as?: 'a' | 'span';
  align?: 'start' | 'center' | 'end';
}
const { href, label, hoverText = label, external = false, as: Tag = 'a', align = 'start' } = Astro.props;
---

<Tag
  class="hover-link"
  href={Tag === 'a' ? href : undefined}
  data-hover-text={hoverText}
  style={`--hover-align: ${align}`}
  aria-label={Tag === 'a' ? label : undefined}
  target={Tag === 'a' && external ? '_blank' : undefined}
  rel={Tag === 'a' && external ? 'noopener' : undefined}
>
  <span class="hover-link__inner">{label}</span>
  <span class="hover-link__next" aria-hidden="true">
    {hoverText}
  </span>
</Tag>

<style>
  /* Both labels travel the same distance inside a fixed mask, including on reversal. */
  .hover-link {
    position: relative;
    display: inline-grid;
    place-items: center var(--hover-align);
    min-height: 24px;
    overflow: hidden;
    vertical-align: middle;
  }
  .hover-link__next {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center var(--hover-align);
    transform: translate3d(0, 100%, 0);
    overflow: hidden;
  }
  .hover-link::after {
    content: attr(data-hover-text);
    grid-area: 1 / 1;
    visibility: hidden;
    white-space: nowrap;
  }
  .hover-link__inner,
  .hover-link__next {
    transition: transform var(--duration-hover) var(--ease-hover);
    white-space: nowrap;
  }
  .hover-link__inner {
    grid-area: 1 / 1;
    display: grid;
    place-items: center var(--hover-align);
    min-height: 24px;
    height: 100%;
  }
  .hover-link:is(:hover, :focus-visible) .hover-link__next,
  :global(a:is(:hover, :focus-visible)) > .hover-link .hover-link__next {
    transform: translate3d(0, 0, 0);
  }
  .hover-link:is(:hover, :focus-visible) .hover-link__inner,
  :global(a:is(:hover, :focus-visible)) > .hover-link .hover-link__inner {
    transform: translate3d(0, -100%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .hover-link__inner,
    .hover-link__next {
      transition: none;
    }
  }
</style>
