---
import { href } from '@/lib/paths';

interface Props {
  variant: 'experience' | 'shape' | 'convert';
}

const { variant } = Astro.props;
---

<span class="inline-pic" data-inline-pic>
  <picture>
    <source media="(prefers-reduced-motion: reduce)" srcset={href(`media/inline/${variant}-still.webp`)} />
    <img src={href(`media/inline/${variant}.webp`)} alt="" width="150" height="150" class="inline-pic__image" loading="lazy" />
  </picture>
</span>

<style>
  .inline-pic {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin: 0 0.06em;
    vertical-align: -0.1em;
    overflow: hidden;
    border-radius: 0.16em;
    opacity: var(--rise-a, 1);
  }

  .inline-pic picture,
  .inline-pic__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
