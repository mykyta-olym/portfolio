---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AvatarButton from '@/components/ui/AvatarButton.astro';
import Icon from '@/components/ui/Icon.astro';
import HoverLink from '@/components/ui/HoverLink.astro';
import { links, profile } from '@/data/profile';
import { href } from '@/lib/paths';
---

<BaseLayout
  title="Contact"
  pill="contact"
  footer={false}
  description="Contact Mykyta Olym by email, Telegram or LinkedIn. Based in Košice, Slovakia."
>
  <section class="contact" aria-labelledby="contact-title">
    <picture class="contact__backdrop" aria-hidden="true">
      <source media="(prefers-reduced-motion: reduce)" srcset={href('media/contact/cubic-still.webp')} />
      <img src={href('media/contact/cubic-loop.webp')} alt="" width="800" height="500" fetchpriority="high" />
    </picture>

    <div class="contact__centre">
      <h1 class="contact__title" id="contact-title" data-reveal="lines">
        Let's talk ideas
      </h1>
      <p class="contact__text" data-reveal="lines" data-reveal-delay="0.15">
        Tell me about a project, a role or a question about my code. Email reaches me fastest.
      </p>
      <div data-reveal="fade" data-reveal-delay="0.25">
        <AvatarButton href={links.email.href} hoverText="Say hello">
          Send an Email
        </AvatarButton>
      </div>
    </div>

    <div class="contact__card contact__card--mail" data-reveal="fade" data-reveal-delay="0.3">
      <div class="contact__paper">
        <p class="contact__card-label">E-mail</p>
        <div class="contact__mail">
          <a href={links.email.href}>{profile.email}</a>
          <button class="contact__copy" type="button" data-module="copy" data-copy={profile.email} aria-label="Copy the email address">
            <Icon name="copy" size={13} class="contact__copy-icon" />
            <Icon name="check" size={13} class="contact__copied-icon" />
          </button>
          <span class="visually-hidden" aria-live="polite" data-copy-status></span>
        </div>
      </div>
    </div>

    <div class="contact__card contact__card--social" data-reveal="fade" data-reveal-delay="0.4">
      <div class="contact__paper">
        <p class="contact__card-label">Socials</p>
        <ul>
          {[links.github, links.linkedin, links.telegram].map((link) => (
            <li>
              <HoverLink href={link.href} label={`[${link.label}]`} hoverText={link.hoverText} align="center" external />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    padding: 7rem var(--gutter) 6rem;
    background: #000;
  }

  .contact__backdrop,
  .contact__backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.53;
  }

  .contact__centre {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(42vw, 37rem);
    text-align: center;
    transform: translateY(-35px);
  }

  .contact__title {
    font-size: 70px;
    font-weight: 400;
    letter-spacing: -1.5px;
    line-height: 62px;
    color: #b8b8b8;
  }

  .contact__text {
    margin-top: 60px;
    font-size: 15px;
    line-height: 16px;
    color: #efefef;
  }

  .contact__centre > div {
    margin-top: 36px;
  }
  .contact__centre :global(.avatar-button) {
    width: clamp(168px, 12.18vw, 234px);
    height: clamp(52px, 3.56vw, 68px);
    padding: 8px;
    background: rgb(255 255 255 / 71%);
  }
  .contact__centre :global(.avatar-button__image) {
    width: clamp(36px, 2.72vw, 52px);
    height: clamp(36px, 2.72vw, 52px);
  }

  /* Source contact cards: translucent shell, white paper and the original CRT overlay. */
  .contact__card {
    position: absolute;
    width: max(270px, calc(25.45% - 120px));
    padding: 0 5px 5px;
    border-radius: 6px;
    background: rgb(255 255 255 / 71%);
    color: #242424;
    font-size: var(--fs-small);
  }
  .contact__paper {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 15px;
    padding: 5px;
    border-radius: 6px;
    background: #fff;
  }
  .contact__paper::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 22%) 0 1px, rgb(255 255 255 / 4%) 2px, transparent 4px);
    opacity: 0.3;
    mix-blend-mode: multiply;
  }

  .contact__card--mail {
    top: calc(50% - 176px);
    left: 120px;
  }
  .contact__card--social {
    right: 120px;
    top: calc(50% - 1px);
    text-align: center;
  }

  .contact__card-label {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 1px 10px 0;
    border-bottom: 1px solid rgb(0 0 0 / 25%);
    font-family: var(--font-label);
    font-size: var(--fs-tag);
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #000;
  }
  .contact__card--social .contact__card-label {
    justify-content: center;
  }
  .contact__card--social ul {
    display: grid;
    padding-block: 5px;
  }
  .contact__card--social li {
    display: flex;
    justify-content: center;
  }
  .contact__card--social :global(.hover-link) {
    min-width: 7rem;
    min-height: 28px;
  }

  .contact__mail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    overflow-wrap: anywhere;
    min-height: 26px;
    margin-top: 5px;
    padding-inline: 10px;
  }

  .contact__mail a,
  .contact__card--social :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact__copy {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
  .contact__copy:focus-visible {
    outline-color: #000;
  }
  .contact__copy :global(.contact__copied-icon),
  .contact__copy:global(.is-copied) :global(.contact__copy-icon) {
    display: none;
  }
  .contact__copy:global(.is-copied) :global(.contact__copied-icon) {
    display: block;
  }

  @media (max-width: 1439px) and (min-width: 768px) {
    .contact__title {
      font-size: 60px;
      line-height: 1.05;
      letter-spacing: -2px;
    }
    .contact__card {
      width: 270px;
    }
    .contact__card--mail {
      top: auto;
      bottom: 8vh;
      left: 4vw;
    }
    .contact__card--social {
      top: auto;
      right: 4vw;
      bottom: 8vh;
    }
  }

  @media (max-width: 767px) {
    .contact {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 55px;
      padding: min(33svh, 280px) 0 100px;
    }
    .contact__backdrop img {
      object-fit: contain;
      object-position: bottom center;
    }
    .contact__centre {
      transform: none;
      margin-bottom: 0;
      width: 100%;
    }
    .contact__title {
      font-size: 48px;
      line-height: 45px;
    }
    .contact__text {
      margin-top: 30px;
      padding-inline: 30px;
      font-size: 14px;
      line-height: 18px;
      min-height: 54px;
    }
    .contact__centre > div {
      margin-top: 70px;
    }
    .contact__card {
      position: relative;
      inset: auto;
      width: 290px;
      max-width: calc(100% - 32px);
      padding: 0 3px 3px;
      font-size: 12px;
    }
    .contact__paper {
      padding: 0;
    }
    .contact__card-label {
      height: 29px;
    }
    .contact__mail {
      margin-top: 0;
    }
    .contact__card--social {
      display: none;
    }
  }
</style>
