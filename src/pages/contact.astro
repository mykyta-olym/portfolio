---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AvatarButton from '@/components/ui/AvatarButton.astro';
import Icon from '@/components/ui/Icon.astro';
import { links, profile } from '@/data/profile';
import { href } from '@/lib/paths';
---

<BaseLayout
  title="Contact"
  pill="contact"
  footer={false}
  description="Contact Mykyta Olym by email, Telegram or LinkedIn. Based in Košice, Slovakia."
>
  <section class="contact" aria-labelledby="contact-title">
    <picture class="contact__backdrop" aria-hidden="true">
      <source media="(prefers-reduced-motion: reduce)" srcset={href('media/contact/cubic-still.webp')} />
      <img src={href('media/contact/cubic-loop.webp')} alt="" width="800" height="500" fetchpriority="high" />
    </picture>

    <div class="contact__centre">
      <h1 class="contact__title" id="contact-title" data-reveal="lines">
        Let's talk
      </h1>
      <p class="contact__text" data-reveal="lines" data-reveal-delay="0.15">
        Tell me about a project, a role or a question about my code. Email reaches me fastest.
      </p>
      <div data-reveal="fade" data-reveal-delay="0.5">
        <AvatarButton href={links.email.href}>Send an Email</AvatarButton>
      </div>
    </div>

    <div class="contact__card contact__card--mail" data-reveal="fade" data-reveal-delay="0.6">
      <p class="contact__card-label">E-mail</p>
      <div class="contact__mail">
        <a href={links.email.href}>{profile.email}</a>
        <button class="contact__copy" type="button" data-module="copy" data-copy={profile.email} aria-label="Copy the email address">
          <Icon name="copy" size={13} class="contact__copy-icon" />
          <Icon name="check" size={13} class="contact__copied-icon" />
        </button>
        <span class="visually-hidden" aria-live="polite" data-copy-status></span>
      </div>
    </div>

    <div class="contact__card contact__card--social" data-reveal="fade" data-reveal-delay="0.75">
      <p class="contact__card-label">Socials</p>
      <ul>
        {[links.github, links.linkedin, links.telegram].map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener">
              [{link.label}]
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    overflow: hidden;
    padding: 7rem var(--gutter) 6rem;
    background: #000;
  }

  .contact__backdrop,
  .contact__backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact__centre {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    max-width: 37rem;
    text-align: center;
    transform: translateY(-3vh);
  }

  .contact__title {
    font-size: clamp(3rem, 5vw, 7.5rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
    color: #c2c2c2;
  }

  .contact__text {
    font-size: var(--fs-body);
    line-height: 1.2;
    color: #eee;
  }

  /* The reference's small, horizontal-rule paper cards. */
  .contact__card {
    position: absolute;
    width: clamp(14rem, 17.36vw, 19rem);
    padding: 0.65rem;
    border: 6px solid #b5b5b5;
    border-top-width: 15px;
    border-radius: 6px;
    background: repeating-linear-gradient(#fff 0 1px, #d6d6d6 1px 2px, #fafafa 2px 4px);
    color: #111;
    font-size: var(--fs-small);
  }

  .contact__card--mail {
    top: 30vh;
    left: 8.3vw;
  }
  .contact__card--social {
    right: 8.3vw;
    bottom: 34vh;
    text-align: center;
  }

  .contact__card-label {
    margin-bottom: 0.4rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid #555;
    font-family: var(--font-label);
    font-size: var(--fs-tag);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__mail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem;
    overflow-wrap: anywhere;
  }

  .contact__mail a,
  .contact__card--social a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .contact__card--social a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .contact__copy {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
  .contact__copy:focus-visible {
    outline-color: #000;
  }
  .contact__copy :global(.contact__copied-icon),
  .contact__copy:global(.is-copied) :global(.contact__copy-icon) {
    display: none;
  }
  .contact__copy:global(.is-copied) :global(.contact__copied-icon) {
    display: block;
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .contact__card--mail {
      top: auto;
      bottom: 8vh;
      left: 4vw;
    }
    .contact__card--social {
      right: 4vw;
      bottom: 8vh;
    }
  }

  @media (max-width: 767px) {
    .contact {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      padding-top: 9rem;
    }
    .contact__centre {
      transform: none;
      margin-bottom: 1rem;
    }
    .contact__card {
      position: relative;
      inset: auto;
      width: 100%;
      max-width: 22rem;
    }
  }
</style>
